{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Jeong-jin-Han/NodeGraph/main/docs/schemas/synthesis-claims.schema.json",
  "title": "NodeGraph Synthesis Claims Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claims",
    "modified"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "nodegraph-synthesis-claims"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/semanticVersion"
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "synthesis-claim.schema.json"
      }
    },
    "modified": {
      "$ref": "common.schema.json#/definitions/timestamp"
    }
  }
}
