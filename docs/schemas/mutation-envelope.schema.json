{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Jeong-jin-Han/NodeGraph/main/docs/schemas/mutation-envelope.schema.json",
  "title": "NodeGraph Mutation Envelope",
  "description": "Single-document optimistic-concurrency mutation request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutationId",
    "targetDocument",
    "baseRevision",
    "operations",
    "requestedAt",
    "actor"
  ],
  "properties": {
    "mutationId": {
      "$ref": "common.schema.json#/definitions/mutationId"
    },
    "targetDocument": {
      "$ref": "common.schema.json#/definitions/projectRelativePath"
    },
    "baseRevision": {
      "$ref": "common.schema.json#/definitions/revisionToken"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/operation"
      }
    },
    "requestedAt": {
      "$ref": "common.schema.json#/definitions/timestamp"
    },
    "actor": {
      "$ref": "common.schema.json#/definitions/actor"
    }
  },
  "definitions": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "replace",
            "test"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:|(?:/(?:[^~/]|~0|~1)*)+)$"
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "add",
                  "replace",
                  "test"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "remove"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    }
  }
}
