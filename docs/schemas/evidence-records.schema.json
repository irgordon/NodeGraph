{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Jeong-jin-Han/NodeGraph/main/docs/schemas/evidence-records.schema.json",
  "title": "NodeGraph Authoritative Evidence Records",
  "description": "Authoritative project evidence records. The evidence index is derived from this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence",
    "modified"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "nodegraph-evidence-records"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/semanticVersion"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "modified": {
      "$ref": "common.schema.json#/definitions/timestamp"
    }
  }
}
