{
  "name": "nodegraph",
  "displayName": "NodeGraph",
  "description": "Node-based knowledge graph for research paper analysis",
  "version": "0.0.0",
  "publisher": "JeongjinHan",
  "icon": "resources/icon-hires.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/irgordon/NodeGraph"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Education"
  ],
  "activationEvents": [
    "onCustomEditor:nodegraph.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "nodegraph.editor",
        "displayName": "NodeGraph Editor",
        "selector": [
          {
            "filenamePattern": "*.nodegraph.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "nodegraph.new",
        "title": "NodeGraph: New Graph"
      },
      {
        "command": "nodegraph.search",
        "title": "NodeGraph: Search Nodes"
      },
      {
        "command": "nodegraph.copyAgentSpec",
        "title": "NodeGraph: Copy Agent Spec to Workspace"
      },
      {
        "command": "nodegraph.project.create",
        "title": "NodeGraph: Create Literature Project"
      },
      {
        "command": "nodegraph.project.open",
        "title": "NodeGraph: Open Literature Project"
      },
      {
        "command": "nodegraph.project.registerPaper",
        "title": "NodeGraph: Register Project Paper"
      },
      {
        "command": "nodegraph.project.unregisterPaper",
        "title": "NodeGraph: Unregister Project Paper"
      },
      {
        "command": "nodegraph.project.validate",
        "title": "NodeGraph: Validate Literature Project"
      },
      {
        "command": "nodegraph.project.rebuildIndexes",
        "title": "NodeGraph: Rebuild Project Indexes"
      },
      {
        "command": "nodegraph.project.search",
        "title": "NodeGraph: Search Project Papers"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "nodegraph.new",
          "when": "explorerResourceIsFolder",
          "group": "nodegraph"
        },
        {
          "command": "nodegraph.copyAgentSpec",
          "when": "explorerResourceIsFolder",
          "group": "nodegraph"
        },
        {
          "command": "nodegraph.project.create",
          "when": "explorerResourceIsFolder",
          "group": "nodegraph"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+f",
        "mac": "cmd+f",
        "command": "nodegraph.search",
        "when": "activeCustomEditorId == 'nodegraph.editor'"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:contracts && npm run test:phase1",
    "test:contracts": "node tools/validate-synthesis-contracts.js",
    "test:phase1": "node tools/run-phase1-tests.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "katex": "^0.17.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
