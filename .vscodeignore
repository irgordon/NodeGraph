# Internal instructions and generated environment copies
AGENTS.md
.agent/ENVIRONMENT.md

# Source and build tooling — not needed at runtime
src/
tools/
esbuild.js
tsconfig.json
package-lock.json

# Tests, contract fixtures, and temporary output
tmp/
test/
test-demo/
docs/schemas/fixtures/
coverage/
*.log
*.tmp
*.bak
*.swp
**/.DS_Store

# Ship the five graph JSON examples, but not source papers, generated exports,
# paper-derived sidecar media, or per-demo environment reports.
demo/**/*.pdf
demo/**/*.html
demo/**/.*-imgs/
demo/**/.agent/

# README-linked release media is retained; unreferenced variants and recordings
# stay in the repository.
resources/banner.png
resources/icon.png
resources/demo-ex3.mp4
resources/demo-ex3.webp
resources/demo-ex4.mp4

# Generated VSIX builds must never be packaged recursively
*.vsix
**/*.vsix

# Dev-only build output (sourcemaps — only emitted by non-production builds)
dist/*.map

# Dev dependencies
node_modules/

# Git and editor internals
.git/
.gitignore
.vscode/
.claude/
.codex/
